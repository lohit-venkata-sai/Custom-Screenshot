{
  "manifest_version": 3,
  "name": "Custom Screenshot",
  "description": "Capture screenshots your way.",
  "version": "1.1.0",
  "action": {
    "default_title": "Custom Screenshot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "downloads", "activeTab", "scripting", "sidePanel", "notifications", "debugger", "identity", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "instant-capture": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "windows": "Alt+Shift+S",
        "mac": "Command+Shift+S",
        "linux": "Alt+Shift+S"
      },
      "description": "Capture instantly with the active preset (remap to Ctrl+Alt+S in chrome://extensions/shortcuts)"
    }
  }
}
